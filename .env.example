# Price Tracker environment. Copy this file to .env and fill it in.
# Lines that start with # are off. A blank value counts as unset.
# Values marked "also a setting" can change later on the dashboard's Settings
# page; a value saved there wins over this file. Full list:
# https://furey.github.io/price-tracker/reference/configuration

# Dashboard login.
# APP_PASSWORD is required when the server listens on any address other than
# loopback (the Docker image listens on 0.0.0.0). The server refuses to start
# without it unless ALLOW_NO_AUTH=1.
APP_PASSWORD=
# Signs the login cookie. Required with APP_PASSWORD; at least 32 characters.
# Make one with: openssl rand -hex 32
SESSION_SECRET=
# Host header values (port included) that may use the API, comma-separated,
# besides localhost and 127.0.0.1. List each address you type in the browser.
ALLOWED_HOSTS=nas.local:4280
# The address that alert links open on your phone (also a setting).
DASHBOARD_URL=http://nas.local:4280
# 1 lets the server listen on a non-loopback address with no password.
# Anyone who can reach the port can then change your items and settings.
# ALLOW_NO_AUTH=
# Proxy hops to trust for X-Forwarded-For and X-Forwarded-Proto. Set it to 1
# only behind a reverse proxy you control; it also marks the cookie Secure.
# TRUST_PROXY=

# Claude Code login token, from `claude setup-token` on a computer with a
# browser (also a setting). AI research runs on your Claude subscription.
CLAUDE_CODE_OAUTH_TOKEN=

# Region profile: au (default), us, or generic. It sets the currency, locale,
# time zone, trusted retailers, memberships, and sale windows.
REGION=au
# Overrides for the region defaults (also settings).
# CURRENCY=AUD
# LOCALE=en-AU
# TIME_ZONE=Australia/Sydney
# Comma list of store memberships you hold, or none (also a setting).
# MEMBERSHIPS=eBay Plus

# Delivery place, so research records the delivery cost to you (also
# settings). DELIVERY_POSTCODE is 4 digits for au and a ZIP code for us;
# DELIVERY_SUBURB is the suburb (au) or city (us).
# DELIVERY_POSTCODE=
# DELIVERY_SUBURB=

# Phone alerts through ntfy.
# Access token for your ntfy account, if it uses one (also a setting).
# NTFY_ACCESS_TOKEN=
# The only ntfy origin that receives the token. Default https://ntfy.sh.
# NTFY_TRUSTED_SERVER=https://ntfy.sh
# Topic for the app's own notices (also a setting). Leave it unset and the
# app makes a random pt-app-<32 hex> topic. Anyone who knows a topic on
# ntfy.sh can read it and send to it, so keep it secret.
# APP_NTFY_TOPIC=

# Limits on AI research (also settings).
# Research runs per month, 0-1000 (default 150).
# AI_MONTHLY_CAP=150
# Pause AI runs above this share of the Claude weekly limit (default 70).
# CLAUDE_RESERVE_PERCENT=70
# Pause AI runs above this share of the Claude five-hour limit (default 90).
# CLAUDE_SESSION_RESERVE_PERCENT=90
# true pauses every AI run; free direct checks keep running (default false).
# AI_PAUSED=false

# Total size of Chrome check screenshots in MB, 10-5000 (default 200; also a
# setting). The oldest are deleted when an upload passes it.
# SCREENSHOT_CAP_MB=200

# Docker Compose only (read by docker-compose.example.yml, not by the app).
# The user and group that own ./state and ./logs: `id -u` and `id -g`
# (default 1000).
# PUID=1000
# PGID=1000
# Port on this host for the dashboard (default 4280). Use the same port in
# ALLOWED_HOSTS and DASHBOARD_URL.
# HOST_PORT=4280
# Container clock (default UTC). Days and schedules use TIME_ZONE, not TZ.
# TZ=UTC

# Running without Docker (npm or a Mac LaunchAgent).
# HOST=127.0.0.1
# PORT=4280
# CLAUDE_BIN=claude
# CLAUDE_CONFIG_DIR=
# DB_PATH=state/price-tracker.db
